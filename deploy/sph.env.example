# docker compose env_file 模板（对应原 server/.env.example，路径已按容器内调整）
# 微信支付 APIv3 —— 参数均在 商户平台 → 账户中心 → API安全 页获取
WX_APPID=wx1234567890abcdef        # 与商户号关联的公众号/小程序 appid
WX_MCHID=1900000000                # 商户号
WX_SERIAL=ABCDEF1234567890ABCDEF1234567890ABCDEF12  # 商户API证书序列号：openssl x509 -in apiclient_cert.pem -noout -serial
WX_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem   # 商户API私钥（请求签名用）
WX_APIV3KEY=0123456789abcdef0123456789abcdef       # APIv3密钥，32 字符（回调解密用）

# 微信支付公钥模式（2024 后新商户默认；老平台证书模式商户可删这两行）
# pub_key.pem 与公钥ID 均在 API安全 页「微信支付公钥」处下载/查看
WX_PUB_KEY_PATH=/app/certs/pub_key.pem
WX_PUB_KEY_ID=PUB_KEY_ID_0117xxxxxxxxxxxxxxxx      # 回调 Wechatpay-Serial 头的值，必须与此一致才能验签

WX_NOTIFY_URL=https://pay.example.com/api/wxpay/notify   # 公网 HTTPS，域名需在商户平台备案登记

# 内容安全（msgSecCheck/imgSecCheck/mediaCheckAsync，小程序 appsecret，非商户密钥）
WX_APPSECRET=0123456789abcdefghijklmnopqrstuvwxyz0123  # 小程序 appsecret（mp.weixin.qq.com 开发管理获取）
WX_PUSH_TOKEN=sphSecPush2026                           # 消息推送验签 Token，与小程序后台「消息推送」填的一致

# 业务
PRICE_CENTS=100
ORDER_TTL_SECONDS=900

# A2M（支付宝按量付费）¥1 打包交付：音频提取 + ASR 文字提取
ARK_API_KEY=                        # 火山引擎 API Key（X-Api-Key；控制台 API Key 管理；缺失 → 文字稿 skipped）
#ASR_RESOURCE_ID=volc.seedasr.sauc.duration   # 豆包流式 ASR 2.0 小时版（默认）；1.0=volc.bigasr.sauc.duration
#ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
#ASR_CHUNK_INTERVAL_MS=0            # 音频分片发送间隔（0=不限速；被服务端断开时再调大）
#ASR_TIMEOUT_MS=300000              # 单次转写总超时
#A2M_MAX_DURATION_S=7200            # 超 2h 视频拒出账单（防 ASR 成本倒挂）
#A2M_ARTIFACT_TTL_HOURS=48          # 音频/文字稿产物保留时长（过期清扫，不自动重跑）

# sph 解析（自有服务，wx_channels_download sph-api 公开 API）
SPH_BASE=https://sph.yes-tek.com
# 以下超时均有内置默认值，按需覆盖
#SPH_REQUEST_TIMEOUT_MS=10000   # 单请求超时
#SPH_POLL_INTERVAL_MS=1500      # 轮询间隔
#SPH_RESOLVE_TIMEOUT_MS=90000   # 解析总超时

# 达人检索上游（wx-webtop-old 容器下载器 API；容器内访问宿主）
FINDER_BASE=http://host.docker.internal:2027
#FINDER_REQUEST_TIMEOUT_MS=10000

# 服务（容器内固定）
PORT=8787
DB_PATH=/app/data/orders.db

ADMIN_TOKEN=change-me-please
