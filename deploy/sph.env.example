# docker compose env_file 模板（对应原 server/.env.example，路径已按容器内调整）
# 微信支付 APIv3
WX_APPID=wxxxxxxxxxxxxxxxx
WX_MCHID=1900000000
WX_SERIAL=ABCDEF1234567890ABCDEF1234567890ABCDEF12
WX_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WX_APIV3KEY=0123456789abcdef0123456789abcdef
WX_NOTIFY_URL=https://pay.example.com/api/wxpay/notify

# 业务
PRICE_CENTS=199
ORDER_TTL_SECONDS=900

# sph 解析
SPH_BASE=https://sph.miuistore.com
SIGN_TTL_MS=600000
HEADED=0

# 服务（容器内固定）
PORT=8787
DB_PATH=/app/data/orders.db

# 本地联调: docker compose run -e MOCK_PAY=1 -p 8787:8787 sph-server
MOCK_PAY=0
ADMIN_TOKEN=change-me-please
