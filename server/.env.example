# ===== 微信支付 APIv3 =====
# 公众号/小程序 appid（与服务号关联的）
WX_APPID=wxxxxxxxxxxxxxxxx
# 商户号
WX_MCHID=1900000000
# 商户 API 证书序列号
WX_SERIAL=ABCDEF1234567890ABCDEF1234567890ABCDEF12
# 商户 API 私钥（apiclient_key.pem 内容，或用文件路径）
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# APIv3 密钥（32 字节）
WX_APIV3KEY=0123456789abcdef0123456789abcdef
# 支付回调地址（公网 HTTPS）
WX_NOTIFY_URL=https://pay.example.com/api/wxpay/notify
# 微信支付公钥模式（2024 后新商户默认；老平台证书模式商户可删）
# pub_key.pem 与公钥ID 在 商户平台→API安全→微信支付公钥 下载/查看
WX_PUB_KEY_PATH=./certs/pub_key.pem
WX_PUB_KEY_ID=PUB_KEY_ID_0117xxxxxxxxxxxxxxxx

# ===== 业务 =====
# 单价（分）
PRICE_CENTS=199
# 订单未付过期（秒）
ORDER_TTL_SECONDS=900

# ===== sph 解析（自有服务，wx_channels_download sph-api 公开 API）=====
SPH_BASE=https://sph.yes-tek.com
# 以下超时均有内置默认值，按需覆盖
#SPH_REQUEST_TIMEOUT_MS=10000   # 单请求超时
#SPH_POLL_INTERVAL_MS=1500      # 轮询间隔
#SPH_RESOLVE_TIMEOUT_MS=90000   # 解析总超时

# ===== AI 按量付费（A2M，支付宝 /api/a2m/*）=====
# 单资源价格（分，默认同 PRICE_CENTS）；支付窗口（秒，默认 900）
#A2M_PRICE_CENTS=100
#A2M_PAY_BEFORE_SECONDS=900
# 沙箱：项目根 .alipay-sandbox.json（skill 快速沙箱创建，已 gitignore），无需以下变量；
# 生产：以下全齐才启用（网关必须显式给出，缺一项即视为未配置，/api/a2m/* 返回 503）
#ALIPAY_APP_ID=
# 应用私钥（PKCS#1 原始 Base64，或文件路径二选一）
#ALIPAY_APP_PRIVATE_KEY=
#ALIPAY_APP_PRIVATE_KEY_PATH=
# 支付宝公钥（或文件路径）
#ALIPAY_PUBLIC_KEY=
#ALIPAY_PUBLIC_KEY_PATH=
#ALIPAY_SELLER_ID=2088...
# 服务市场真实 serviceId（沙箱固定 api_mock_service_id，生产禁用）
#ALIPAY_SERVICE_ID=
#ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
#ALIPAY_SELLER_NAME=sph-pay

# ===== A2M ¥1 打包交付：音频提取 + ASR 文字提取（火山豆包单向流式 ASR）=====
# 火山引擎 API Key（X-Api-Key，控制台 API Key 管理；缺失 → 文字稿 skipped，不影响视频/音频）
#ARK_API_KEY=
# 模型版本：豆包 2.0 小时版（默认）；1.0=volc.bigasr.sauc.duration
#ASR_RESOURCE_ID=volc.seedasr.sauc.duration
#ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
#ASR_CHUNK_INTERVAL_MS=0            # 分片发送间隔（0=不限速；被服务端断开再调大）
#ASR_TIMEOUT_MS=300000
#A2M_MAX_DURATION_S=7200            # 超长视频拒出账单（防 ASR 成本倒挂）
#A2M_ARTIFACT_TTL_HOURS=48          # 产物保留时长（过期清扫）

# ===== 服务 =====
PORT=8787
# 数据库文件
DB_PATH=./data/orders.db
# MOCK_PAY=1 时挂载 /api/dev/* 模拟支付路由（仅本地调试）
MOCK_PAY=0
# 管理接口 token（手动退款等）
ADMIN_TOKEN=change-me-please
