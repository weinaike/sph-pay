# ===== 微信支付 APIv3 =====
# 公众号/小程序 appid（与服务号关联的）
WX_APPID=wxxxxxxxxxxxxxxxx
# 商户号
WX_MCHID=1900000000
# 商户 API 证书序列号
WX_SERIAL=ABCDEF1234567890ABCDEF1234567890ABCDEF12
# 商户 API 私钥（apiclient_key.pem 内容，或用文件路径）
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# APIv3 密钥（32 字节）
WX_APIV3KEY=0123456789abcdef0123456789abcdef
# 支付回调地址（公网 HTTPS）
WX_NOTIFY_URL=https://pay.example.com/api/wxpay/notify
# 微信支付公钥模式（2024 后新商户默认；老平台证书模式商户可删）
# pub_key.pem 与公钥ID 在 商户平台→API安全→微信支付公钥 下载/查看
WX_PUB_KEY_PATH=./certs/pub_key.pem
WX_PUB_KEY_ID=PUB_KEY_ID_0117xxxxxxxxxxxxxxxx

# ===== 业务 =====
# 单价（分）
PRICE_CENTS=199
# 订单未付过期（秒）
ORDER_TTL_SECONDS=900

# ===== sph 解析（自有服务，wx_channels_download sph-api 公开 API）=====
SPH_BASE=https://sph.yes-tek.com
# 以下超时均有内置默认值，按需覆盖
#SPH_REQUEST_TIMEOUT_MS=10000   # 单请求超时
#SPH_POLL_INTERVAL_MS=1500      # 轮询间隔
#SPH_RESOLVE_TIMEOUT_MS=90000   # 解析总超时

# ===== 服务 =====
PORT=8787
# 数据库文件
DB_PATH=./data/orders.db
# MOCK_PAY=1 时挂载 /api/dev/* 模拟支付路由（仅本地调试）
MOCK_PAY=0
# 管理接口 token（手动退款等）
ADMIN_TOKEN=change-me-please
